<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f3f4f6;">
  <div style="max-width: 800px; margin: 40px auto; background-color: #ffffff; border-radius: 8px; border: 1px solid #e5e7eb; overflow: hidden;">
    <!-- Header -->
    <div style="background-color: #667eea; color: #ffffff; padding: 32px;">
      <h1 style="margin: 0; font-size: 28px; font-weight: 700;">INVOICE</h1>
      <p style="margin: 8px 0 0 0; opacity: 0.9;">{{invoiceDate}}</p>
    </div>

    <!-- Content -->
    <div style="padding: 32px;">
      <!-- Company and Customer Info -->
      <div style="display: flex; width:90vw; margin-bottom: 32px;justify-content:end;">
        <div style="display:flex; flex-direction:column; text-align: right;gap:2px">
          <h3 style="margin: 0 0 8px 0; color: #374151; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em;">Bill To</h3>
          <p style="margin: 0; color: #111827; font-weight: 600; font-size: 16px;">{{firstName}} {{lastName}}</p>
          <p style="margin: 4px 0 0 0; color: #6b7280;">{{email}}</p>
          <h4 style="margin: 0 0 8px 0; color: #374151; font-size: 14px; text-transform: uppercase; letter-spacing: 0.05em;">Company</h4>
          <p style="margin: 0; color: #111827; font-weight: 600; font-size: 16px;">{{companyName}}</p>
          <p style="margin: 4px 0 0 0; color: #6b7280;">{{companyEmail}}</p>
        </div>
      </div>

      <!-- Jobs Table -->
      <table style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
        <thead>
          <tr style="background-color: #f3f4f6;">
            <th style="padding: 12px 16px; text-align: left; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Job Description</th>
            <th style="padding: 12px 16px; text-align: right; font-weight: 600; color: #374151; border-bottom: 2px solid #e5e7eb;">Amount</th>
          </tr>
        </thead>
        <tbody>
          {{#each jobs}}
          <tr{{#if @first}} style="background-color: #f9fafb;"{{/if}}>
            <td style="padding: 12px 16px; border-bottom: 1px solid #e5e7eb;">{{this.name}}</td>
            <td style="padding: 12px 16px; border-bottom: 1px solid #e5e7eb; text-align: right;">${{this.amount}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <!-- Total -->
      <div style="border-top: 2px solid #e5e7eb; padding-top: 16px;">
        <div style="display: flex; justify-content: flex-end;">
          <div style="text-align: right;">
            <p style="margin: 0; color: #6b7280; font-size: 14px;">Total Amount</p>
            <p style="margin: 4px 0 0 0; color: #111827; font-size: 24px; font-weight: 700;">${{total}}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div style="background-color: #f9fafb; padding: 24px 32px; border-top: 1px solid #e5e7eb;">
      <p style="margin: 0; color: #6b7280; font-size: 14px; text-align: center;">
        Thank you for your business!
      </p>
    </div>
  </div>
</body>
</html>
